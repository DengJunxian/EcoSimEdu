{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CaseScene": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "legacy_stage": {
          "enum": [
            "intro",
            "predict",
            "bid",
            "observe",
            "explain",
            "compare",
            "notebook"
          ],
          "title": "Legacy Stage",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/Role"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "information": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Information",
          "type": "array"
        },
        "action": {
          "anyOf": [
            {
              "enum": [
                "intro",
                "predict",
                "bid",
                "observe",
                "explain",
                "compare",
                "notebook"
              ],
              "type": "string"
            },
            {
              "const": "legacy",
              "type": "string"
            }
          ],
          "title": "Action"
        },
        "observables": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Observables",
          "type": "array"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/Question"
          },
          "title": "Questions",
          "type": "array"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rubric": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rubric"
        },
        "next_scene": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Scene"
        }
      },
      "required": [
        "id",
        "legacy_stage",
        "title",
        "question",
        "objective",
        "information",
        "action",
        "observables",
        "questions",
        "next_scene"
      ],
      "title": "CaseScene",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "selector": {
          "$ref": "#/$defs/Selector"
        },
        "missing": {
          "minLength": 1,
          "title": "Missing",
          "type": "string"
        }
      },
      "required": [
        "selector",
        "missing"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Option": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "feedback": {
          "minLength": 1,
          "title": "Feedback",
          "type": "string"
        },
        "criterion": {
          "anyOf": [
            {
              "enum": [
                "correct",
                "incorrect",
                "uncertain"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Criterion"
        }
      },
      "required": [
        "id",
        "label",
        "feedback"
      ],
      "title": "Option",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/Option"
          },
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "concept",
                "prediction"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "selector": {
          "anyOf": [
            {
              "$ref": "#/$defs/Selector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "prompt",
        "options"
      ],
      "title": "Question",
      "type": "object"
    },
    "Role": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "goal": {
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        }
      },
      "required": [
        "actor_id",
        "label",
        "goal"
      ],
      "title": "Role",
      "type": "object"
    },
    "Selector": {
      "additionalProperties": false,
      "properties": {
        "event_type": {
          "minLength": 1,
          "title": "Event Type",
          "type": "string"
        },
        "actor_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor Id"
        },
        "fields": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "equals": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "propertyNames": {
                "minLength": 1
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Equals"
        },
        "nonempty": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nonempty"
        },
        "metric_positive": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Positive"
        }
      },
      "required": [
        "event_type",
        "fields"
      ],
      "title": "Selector",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "content_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+(-draft)?$",
      "title": "Content Version",
      "type": "string"
    },
    "engine_version": {
      "minLength": 1,
      "title": "Engine Version",
      "type": "string"
    },
    "source_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/CaseScene"
      },
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "content_version",
    "engine_version",
    "source_ids",
    "scenes"
  ],
  "title": "LessonScenes",
  "type": "object"
}
